# =============================================================================
# Veyro Frontend Environment Variables
# =============================================================================
# In Local Development:
# Leave this empty or omit the .env file — Vite will automatically proxy '/api' to http://localhost:5000

# In Production (e.g. Vercel, Netlify):
# Set VITE_API_URL in your deployment platform's environment settings:
VITE_API_URL=https://your-backend-url.onrender.com/api
