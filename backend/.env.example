# =============================================================================
# Veyro Backend Environment Variables
# =============================================================================
# Duplicate this file as .env and fill in your real credentials:
# cp .env.example .env

# Server Port
PORT=5000

# Environment Mode (development | production)
NODE_ENV=development

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/veyro_db?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/veyro_db

# Frontend Client URL (for CORS allowance)
CLIENT_URL=http://localhost:5173

# JWT Authentication Secrets & Expirations
# Generate secure keys using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Optional: Initial Admin Seed Credentials (used by npm run seed:admin)
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@veyro.com
ADMIN_PASSWORD=AdminPassword@123456
